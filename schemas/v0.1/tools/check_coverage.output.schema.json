{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.theservicemarketingguys.com/standards/open-service-profile/v0.1/check_coverage.output.schema.json",
  "type": "object",
  "required": [
    "covered",
    "canonicalSiteUrl"
  ],
  "properties": {
    "covered": {
      "type": "boolean"
    },
    "areaName": {
      "type": "string"
    },
    "areaUrl": {
      "$ref": "tools-common.schema.json#/$defs/Url"
    },
    "matchedBy": {
      "enum": [
        "postalCodes",
        "radius",
        "location"
      ]
    },
    "phone": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": "string"
    },
    "canonicalSiteUrl": {
      "$ref": "tools-common.schema.json#/$defs/Url"
    }
  },
  "if": {
    "properties": {
      "covered": {
        "const": true
      }
    }
  },
  "then": {
    "required": [
      "areaName",
      "matchedBy"
    ]
  },
  "description": "Output for the Open Service Profile v0.1 tool check_coverage."
}
