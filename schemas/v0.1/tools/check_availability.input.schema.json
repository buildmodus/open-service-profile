{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.theservicemarketingguys.com/standards/open-service-profile/v0.1/check_availability.input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "serviceSlug",
    "from",
    "to"
  ],
  "properties": {
    "serviceSlug": {
      "$ref": "tools-common.schema.json#/$defs/Slug"
